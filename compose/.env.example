# ChaBo docker-compose-vm topology: environment configuration.
# Copy this file to .env and fill in the values.

# Published orchestrator image tag to deploy (no :latest tag is published —
# see https://github.com/ChaBo-Project/ChaBo-Orchestrator releases).
ORCHESTRATOR_TAG=

# Path (absolute, or relative to this file) to this instance's instance_config
# directory (Tier-1/Tier-2 config: params.override.cfg, prompt_overrides.md, instance.yaml).
INSTANCE_CONFIG_PATH=

# Required API tokens.
# HF_TOKEN: required by the orchestrator even for fully self-hosted, non-HF
# deployments — no HF account? Any non-empty placeholder value works, as long as
# nothing HF-hosted (remote embedding/reranker/LLM endpoint) is actually configured.
HF_TOKEN=
# QDRANT_API_KEY: admin (read/write) key — used both by self-hosted Qdrant (infra
# profile) and, by default, by chabo's Qdrant client.
QDRANT_API_KEY=

# Optional — separate read-only key for chabo's Qdrant client (chabo only ever queries,
# never writes, so it doesn't need the admin key above). Leave unset to keep the current
# behavior of chabo using QDRANT_API_KEY directly. Set this once you want to reserve the
# admin key for whatever does ingestion and hand chabo a least-privilege key instead —
# see compose/README.md "Qdrant API keys".
# QDRANT_READ_ONLY_API_KEY=

# Profiles to activate, comma-separated:
#   infra          — local Qdrant (persistent volume)
#   local          — local TEI container for embedding
#   local-reranker — local TEI container for reranking (only needed if
#                    instance_config's [retrieval] reranker_enabled = true —
#                    the orchestrator skips reranking entirely when false, so
#                    don't enable this profile in that case)
#   guard          — Qwen3Guard input-guard classifier (only for [input_guard] mode=classifier)
#   chatui         — ChaBo-ChatUI frontend
# Leave empty (or remove) to use remote HuggingFace endpoints from params.cfg
# and/or a separately deployed ChatUI.
COMPOSE_PROFILES=

# Customize TEI models (must match the vector store embedding model).
# TEI_RERANKER_MODEL only applies when the local-reranker profile is active.
TEI_EMBEDDING_MODEL=BAAI/bge-m3
TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Input-guard classifier model (used when [input_guard] mode=classifier + profile guard):
QWEN3GUARD_MODEL=Qwen/Qwen3Guard-Gen-0.6B

# Uncomment if using alternative LLM providers:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

# Path to this instance's chatui.env.local (only needed with profile chatui):
# CHATUI_ENV_LOCAL_PATH=./chatui.env.local

# ChatUI origin (for non-HTTPS deployments) — set this AND uncomment the matching
# `environment: - ORIGIN=${UI_ORIGIN}` line under the chatui service in
# docker-compose.yml (both are required; this alone does nothing on its own):
# UI_ORIGIN=http://localhost:3000
